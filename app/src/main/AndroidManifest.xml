<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Auto-update: lets the app trigger the system installer for a
         downloaded APK (user still confirms the install). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <application android:usesCleartextTraffic="true" android:label="IPTV" android:icon="@drawable/iptv_icon"
        android:banner="@drawable/iptv_icon" android:theme="@style/AppTheme">
        <!-- configChanges: a rotation (incl. the fullscreen toggle's) is
             handled in onConfigurationChanged instead of recreating the
             activity, so playback never reloads (v2.0.27). -->
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Serves the downloaded update APK to the system installer
             (UpdateChecker.installApk). Authorities must match the
             "${applicationId}.fileprovider" used in code. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
