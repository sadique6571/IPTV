<?xml version="1.0" encoding="utf-8"?>
<!-- Launch background: the app gradient with the IPTV icon centered.
     Shown by the window while MainActivity inflates (cold start), then
     covered by the activity's own opaque gradient background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#050B2E"
                android:centerColor="#0A1245"
                android:endColor="#2A1B6B"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/iptv_icon"
        android:gravity="center"
        android:width="96dp"
        android:height="96dp" />
</layer-list>
